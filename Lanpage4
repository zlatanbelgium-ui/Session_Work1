                    0 0 35px #ffd700;
            }
            /* FLOAT ANIMATION */
            @keyframes floatUpDown {
                0% {
                    transform: translateY(0);
                }
                50% {
                    transform: translateY(-8px);
                }
                100% {
                    transform: translateY(0);
                }
