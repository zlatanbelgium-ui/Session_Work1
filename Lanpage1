  border: 2px solid #D4AF37;
}

/* Gold Glow elegan */
@keyframes goldGlow {
  0%,100% {
    box-shadow: 0 20px 50px rgba(0,0,0,0.8), 0 0 30px rgba(212, 175, 55, 0.2), 0 0 60px rgba(212, 175, 55, 0.05);
