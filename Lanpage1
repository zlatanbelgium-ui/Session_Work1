  <style>
 /* =========================================
   FOOTER UTAMA (HIJAU TUA + EMAS ELEGANT)
   ========================================= */
.RACUNTOTO-TOTO-MACAU {
  display: flex;
  justify-content: space-around;
  align-items: flex-end; /* Agar tombol tengah bisa melayang */
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 99;
  padding: 12px 10px 20px 10px; /* Bawah lebih lebar */
  
  /* Tema Hijau Tua Glassmorphism */
  background: linear-gradient(180deg, rgba(26, 74, 42, 0.98), #0d2618);
  border-top: 2px solid #D4AF37; /* Garis Emas Solid */
  box-shadow: 0 -10px 30px rgba(0,0,0,0.8), 0 0 30px rgba(212, 175, 55, 0.05); /* Bayangan hitam ke atas */
  backdrop-filter: blur(8px); /* Efek kaca buram */
  -webkit-backdrop-filter: blur(8px);
  
  border-radius: 20px 20px 0 0; /* Sudut atas melengkung halus */
  font-family: 'Montserrat', sans-serif;
}

/* Garis emas dekoratif di atas footer */
.RACUNTOTO-TOTO-MACAU::before {
  content: '';
  position: absolute;
  top: -2px;
  left: 15%;
  width: 70%;
  height: 3px;
  background: linear-gradient(90deg, transparent, #D4AF37, #F1C40F, #D4AF37, transparent);
  border-radius: 50%;
  box-shadow: 0 0 30px rgba(212, 175, 55, 0.4);
}

/* =========================================
   BUTTON NAVIGASI (PROMO, LOGIN, DLL)
   ========================================= */
.RACUNTOTO-TOTO-MACAU a {
  text-decoration: none;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #8fc9a8; /* Hijau muda default */
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  transition: all 0.3s ease;
  flex: 1; /* Ukuran rata */
  text-shadow: 0 1px 3px rgba(0,0,0,0.3);
}

.RACUNTOTO-TOTO-MACAU a:hover {
  color: #F1C40F; /* Berubah Emas terang saat hover */
  transform: translateY(-3px);
  text-shadow: 0 0 20px rgba(212, 175, 55, 0.3);
}

/* Styling Icon (GIF) */
.RACUNTOTO-TOTO-MACAU img {
  width: 24px; height: 24px;
  margin-bottom: 4px;
  filter: grayscale(100%) brightness(200%); /* Buat icon jadi putih/abu biar rapi */
  transition: 0.3s;
}

.RACUNTOTO-TOTO-MACAU a:hover img {
  filter: drop-shadow(0 0 10px rgba(212, 175, 55, 0.6)); /* Glow Emas saat hover */
}

/* =========================================
   BUTTON TENGAH (DAFTAR) - SPESIAL
   ========================================= */
.RACUNTOTO-TOTO-MACAU a.tada {
  position: relative;
  top: -25px; /* Naikkan posisi ke atas (Melayang) */
  
  background: linear-gradient(180deg, #1a4a2a, #0d2618); /* Hijau Tua */
  color: #D4AF37; /* Teks Emas */
  
  /* Bentuk Kapsul (Pill) */
  min-width: 60px;
  height: 55px;
  padding: 0 15px;
  border-radius: 50px; 
  
  /* Border Emas */
  border: 3px solid #D4AF37; 
  
  box-shadow: 0 8px 0 #0a1a10, 0 5px 25px rgba(212, 175, 55, 0.2);
  animation: floatGold 3s ease-in-out infinite; /* Animasi melayang halus */
  text-shadow: 0 1px 3px rgba(0,0,0,0.5);
}

.RACUNTOTO-TOTO-MACAU a.tada:hover {
  background: linear-gradient(180deg, #2a6b3e, #1a4a2a);
  box-shadow: 0 6px 0 #0a1a10, 0 10px 35px rgba(212, 175, 55, 0.3);
  border-color: #F1C40F;
  color: #F1C40F;
  transform: translateY(-6px);
}

.RACUNTOTO-TOTO-MACAU a.tada img {
  margin-bottom: 2px;
  width: 22px; height: 22px;
  filter: brightness(0) invert(1) sepia(1) saturate(5) hue-rotate(5deg); /* Icon emas */
}

/* Animasi Melayang - Emas Glow */
@keyframes floatGold {
  0%, 100% { 
    transform: translateY(0); 
    box-shadow: 0 8px 0 #0a1a10, 0 5px 25px rgba(212, 175, 55, 0.2);
  }
  50% { 
    transform: translateY(-5px); 
    box-shadow: 0 6px 0 #0a1a10, 0 15px 40px rgba(212, 175, 55, 0.4);
  }
}

/* Responsif Mobile Kecil */
@media (max-width: 350px) {
  .RACUNTOTO-TOTO-MACAU a { font-size: 9px; }
  .RACUNTOTO-TOTO-MACAU img { width: 20px; height: 20px; }
  .RACUNTOTO-TOTO-MACAU a.tada { width: 50px; height: 50px; min-width: 50px; top: -20px; }
}
