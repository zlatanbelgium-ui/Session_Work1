  50% {
    box-shadow: 0 20px 50px rgba(0,0,0,0.8), 0 0 50px rgba(212, 175, 55, 0.3), 0 0 80px rgba(212, 175, 55, 0.08);
  }
}

/* Garis dekoratif emas di atas */
.popup-container::after {
  content: '';
  position: absolute;
  top: -2px;
  left: 15%;
  width: 70%;
  height: 3px;
  background: linear-gradient(90deg, transparent, #D4AF37, #F1C40F, #D4AF37, transparent);
  border-radius: 50%;
  box-shadow: 0 0 30px rgba(212, 175, 55, 0.4);
  z-index: 5;
}

/* Shine effect */
.popup-container::before {
  content:"";
  position:absolute;
  top:-100%;
  left:-100%;
